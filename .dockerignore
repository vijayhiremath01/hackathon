# .dockerignore for EcoTwin Backend + Python CV Engine
# Build context: repository root (hackatthon/)

# Version control
.git/
.gitignore

# Secrets and environment
.env
.env.local
.env.local.example
*.env
**/.env

# Frontend (deployed separately - do not include)
frontend/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environments and caches
**/.venv/
**/venv/
**/env/
**/.pytest_cache/
**/__pycache__/
**/*.pyc
**/*.pyo

# Build output
**/dist/
**/build/
**/*.tsbuildinfo

# Runtime output directories (created at runtime, not baked into image)
**/captured_images/
**/scan_records/
**/detection_previews/
**/logs/
**/temp/
**/uploads/

# macOS
.DS_Store
**/.DS_Store

# Logs
*.log
npm-debug.log*

# TypeScript
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo

# Misc
coverage/
.nyc_output/