# Backend environment variables
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# Database (Neon PostgreSQL - required)
POSTGRES_URL=postgresql://user:password@host:port/database?sslmode=require&channel_binding=require

# Server
PORT=3000
NODE_ENV=production

# Groq / LLM assistant (server-side only; never expose in frontend)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_MS=30000

# Python CV Engine
# Absolute path to the YOLO model weights inside the container
WASTE_CV_MODEL_PATH=/app/waste-cv-engine/models/yolo26n.pt
# Project root inside the container
APP_PROJECT_ROOT=/app

# Python engine inference tuning (optional - read by waste-cv-engine/config.py)
WASTE_CV_IMAGE_SIZE=960
WASTE_CV_TTA=true
WASTE_CV_TILED_INFERENCE=true
WASTE_CV_TILE_FRACTION=0.72
WASTE_CV_LOG_LEVEL=INFO